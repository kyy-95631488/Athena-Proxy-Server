name = "athena-proxy"
main = "src/index.js"
compatibility_date = "2024-09-23"

[[d1_databases]]
binding = "sharedfile"
database_name = "sharedfile"
database_id = ""

[[kv_namespaces]]
binding = "SHARE_KV"
id = "" 

[observability]
[observability.logs]
enabled = true
invocation_logs = true

[vars]
ADMIN_KEY = ""
